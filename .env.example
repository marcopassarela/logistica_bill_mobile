# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# String de conexão do banco PostgreSQL criado no Layerbase.
# Painel do Layerbase > seu banco > "Quick Connect" > copie a connection string COMPLETA (com a senha).
DATABASE_URL=postgresql://layerbase:SENHA@SEU-HOST.cloud.layerbase.dev:5432/app?sslmode=require

# Login do sistema. Só é usado na PRIMEIRA vez, para criar o acesso no banco.
# Depois, a senha pode ser trocada em Configurações dentro do sistema.
ADMIN_USER=Admin
ADMIN_PASS=troque-esta-senha

# Texto longo e aleatório (assina as sessões de login).
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

PORT=3000
