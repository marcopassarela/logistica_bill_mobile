generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  theme        String   @default("system") // light | dark | system
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  diarias             Diaria[]                  @relation("DiariaCreatedBy")
  faltas              Falta[]                   @relation("FaltaCreatedBy")
  agendamentosCriados AgendamentoCarregamento[] @relation("AgendamentoCreatedBy")
  manutencoesCriadas  ManutencaoProgramada[]    @relation("ManutencaoCreatedBy")
}

enum Role {
  ADMIN
  USER
  MANAGER
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Funcionario {
  id           String            @id @default(cuid())
  nome         String
  cpf          String?           @unique
  telefone     String?
  email        String?
  cargoId      String?
  cargo        Cargo?            @relation(fields: [cargoId], references: [id])
  dataAdmissao DateTime?
  salario      Decimal?          @db.Decimal(12, 2)
  status       StatusFuncionario @default(ATIVO)
  observacoes  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  diarias Diaria[]
  faltas  Falta[]

  @@index([nome])
  @@index([status])
}

enum StatusFuncionario {
  ATIVO
  INATIVO
  AFASTADO
}

model Cargo {
  id        String   @id @default(cuid())
  nome      String   @unique
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionarios Funcionario[]
}

model Caminhao {
  id            String         @id @default(cuid())
  placa         String         @unique
  modelo        String?
  marca         String?
  ano           Int?
  capacidadeKg  Decimal?       @db.Decimal(12, 2)
  tipo          String? // truck, carreta, bitrem etc
  status        StatusCaminhao @default(LIBERADO)
  quilometragem Int?
  renavam       String?
  chassi        String?
  observacoes   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  diarias       Diaria[]
  rotas         Rota[]
  carregamentos Carregamento[]
  agendamentos  AgendamentoCarregamento[]
  manutencoes   ManutencaoProgramada[]

  @@index([placa])
  @@index([status])
}

enum StatusCaminhao {
  LIBERADO
  CARREGANDO
  CARREGADO
  EM_ROTA
  MANUTENCAO
}

model Produto {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nome         String
  descricao    String?
  unidade      String   @default("KG") // KG, UN, LT, SC
  pesoUnitario Decimal? @db.Decimal(12, 3)
  preco        Decimal? @db.Decimal(12, 2)
  categoria    String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  carregamentos CarregamentoItem[]

  @@index([codigo])
  @@index([nome])
}

model Carregamento {
  id          String             @id @default(cuid())
  caminhaoId  String
  caminhao    Caminhao           @relation(fields: [caminhaoId], references: [id])
  data        DateTime           @default(now())
  origem      String?
  destino     String?
  pesoTotal   Decimal            @db.Decimal(14, 3)
  status      StatusCarregamento @default(EM_ANDAMENTO)
  observacoes String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  itens CarregamentoItem[]

  @@index([data])
  @@index([status])
  @@index([caminhaoId])
}

enum StatusCarregamento {
  EM_ANDAMENTO
  FINALIZADO
  EM_ROTA
  CANCELADO
  NAO_CARREGADO
}

model CarregamentoItem {
  id             String                 @id @default(cuid())
  carregamentoId String
  carregamento   Carregamento           @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)
  produtoId      String
  produto        Produto                @relation(fields: [produtoId], references: [id])
  quantidade     Decimal                @db.Decimal(14, 3)
  peso           Decimal                @db.Decimal(14, 3)
  statusItem     StatusItemCarregamento @default(PENDENTE)
  observacao     String?
  ordem          Int                    @default(0)

  @@index([carregamentoId])
}

enum StatusItemCarregamento {
  PENDENTE
  CARREGADO
  NAO_CARREGADO
}

model Diaria {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  caminhaoId    String?
  caminhao      Caminhao?   @relation(fields: [caminhaoId], references: [id])
  data          DateTime
  valor         Decimal     @db.Decimal(12, 2)
  observacao    String?
  createdById   String
  createdBy     User        @relation("DiariaCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([data])
  @@index([funcionarioId])
}

model Falta {
  id            String      @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  data          DateTime
  tipo          TipoFalta
  justificativa String?
  atestadoUrl   String? // path or URL do arquivo
  createdById   String
  createdBy     User        @relation("FaltaCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([data])
  @@index([funcionarioId])
}

enum TipoFalta {
  FALTA
  ATESTADO
  FOLGA
  LICENCA
  OUTRO
}

model Rota {
  id             String     @id @default(cuid())
  nome           String
  origem         String
  destino        String
  origemLat      Float?
  origemLng      Float?
  destinoLat     Float?
  destinoLng     Float?
  distanciaKm    Float?
  caminhaoId     String?
  caminhao       Caminhao?  @relation(fields: [caminhaoId], references: [id])
  status         StatusRota @default(PLANEJADA)
  dataProgramada String?
  observacoes    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  pontos RotaPonto[]

  @@index([status])
  @@index([dataProgramada])
}

enum StatusRota {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model RotaPonto {
  id        String  @id @default(cuid())
  rotaId    String
  rota      Rota    @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  ordem     Int
  nome      String?
  lat       Float
  lng       Float
  endereco  String?
  concluido Boolean @default(false)
}

model Alerta {
  id         String     @id @default(cuid())
  tipo       String // PESO, CAMINHAO, SISTEMA
  titulo     String
  mensagem   String
  severidade Severidade @default(INFO)
  lido       Boolean    @default(false)
  referencia String? // id relacionado
  createdAt  DateTime   @default(now())

  @@index([lido])
  @@index([createdAt])
}

enum Severidade {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

model EnderecoFavorito {
  id        String   @id @default(cuid())
  nome      String
  pasta     String   @default("Favoritos")
  query     String
  endereco  String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ==========================================
// AGENDAMENTOS E MANUTENÇÕES PROGRAMADAS
// ==========================================

enum StatusAgendamentoCarregamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

model AgendamentoCarregamento {
  id         String                        @id @default(cuid())
  userId     String
  user       User                          @relation("AgendamentoCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  caminhaoId String
  caminhao   Caminhao                      @relation(fields: [caminhaoId], references: [id])
  peso       Decimal                       @db.Decimal(14, 3)
  dataHora   DateTime
  origem     String
  destino    String
  status     StatusAgendamentoCarregamento @default(AGENDADO)
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt

  @@index([status, dataHora])
  @@index([caminhaoId])
  @@index([userId])
}

enum StatusManutencaoProgramada {
  ATIVA
  CONCLUIDA
  CANCELADA
}

model ManutencaoProgramada {
  id                String                     @id @default(cuid())
  userId            String
  user              User                       @relation("ManutencaoCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  caminhaoId        String
  caminhao          Caminhao                   @relation(fields: [caminhaoId], references: [id])
  descricao         String
  dataHora          DateTime?
  quilometragemAlvo Int?
  status            StatusManutencaoProgramada @default(ATIVA)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, dataHora])
  @@index([caminhaoId, quilometragemAlvo])
  @@index([userId])
}

